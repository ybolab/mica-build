# Environment keys this tree reads. Placeholders only; a real .env is
# git-ignored. Nothing here is required for a default `make` -- every key has
# a built-in default -- but each one changes behaviour and is worth knowing.

# --- build/ and verify/ (Bun) ----------------------------------------------
# Where image tools come from: host binaries, or the pinned toolbox container.
MOS_BUILD_TOOLBOX=
# Docker binary/endpoint override for the toolbox path.
MOS_BUILD_DOCKER=
# Board the `--verify` / `--mkimage-*` drivers act on when not passed --board.
MOS_BOARD=

# --- mosd (Rust, on the device) -------------------------------------------
# Test/bench overrides; the shipped units set none of these.
MOSD_BUS=
MOSD_CONFIG_DIR=
MOSD_SETTINGS_PATH=
MOSD_META_MANIFEST_PATH=
MOSD_UPDATE_POLICY_PATH=
MOSD_UPDATE_SUPPRESSION_PATH=
MOSD_PROVISIONING_ROOT=
MOSD_RAUC_UPDATE_BIN=
MOSD_SCAN=
MOSD_DRY_RUN=
