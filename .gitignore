talos/
out/
os/boards/*/bsp/out/
_out/

# Development TUF signing keys, generated by `rauc-sign gen-dev-keys`.
# Key material is never committed.
os/pkgs/rauc-sign/.devkeys/

# Development RAUC bundle signing material, generated by
# os/pkgs/rauc/gen-dev-keys.sh. Key material is never committed; a committed signing
# key would make every device trust anything anyone builds.
os/pkgs/rauc/.devkeys/

# The RAUC system configuration is RENDERED from os/pkgs/rauc/system.conf.in and
# os/boards/cx3576/board.env by os/pkgs/rauc/render-config.sh, which os/rootfs/build-v2.sh
# runs before staging the overlay. It is generated rather than committed so the
# template stays the single source of truth and the rendered file cannot drift
# away from it.
os/rootfs/overlay-v2/etc/rauc/system.conf

# Optional local RAUC keyring for developer images: a copy of a dev CA cert
# dropped in so a locally built image can install locally built bundles.
os/rootfs/overlay-v2/etc/rauc/keyring.pem

# Built by os/pkgs/rauc/build.sh, like os/pkgs/podman/out-*: compiled artefacts, not source.
os/pkgs/rauc/out-*/
os/pkgs/rauc/versions.lock

# Session/build scratch shared with containers (bind-mount root; never /tmp -- the
# docker daemon does not share this session's /tmp). All throwaway compile, verify
# and container-exchange paths belong here.
runtime/
