out/
boards/*/bsp/out/
_out/

# Development TUF signing keys, generated by `rauc-sign gen-dev-keys`.
# Key material is never committed.
# Retired dev-key location: the trust root moved to /ca/, but stale
# .devkeys dirs (holding a private CA key) still exist on dev machines.
pkgs/rauc/.devkeys/
pkgs/rauc-sign/.devkeys/

# The trust root the build signs bundles with and stages into the image at
# /etc/rauc/keyring.pem -- the single seam by which a CA enters a build. It is
# either production material an operator put there or a development-grade one
# pkgs/rauc/gen-dev-keys.sh generated (marked by ca/GENERATED). Neither is
# ever committed: a committed signing key would make every device trust
# anything anyone builds, and a committed production CA cert would let this
# repository's history decide what the fleet trusts.
/ca/

# The RAUC system configuration is RENDERED from pkgs/rauc/system.conf.in and
# boards/cx3576/board.env by pkgs/rauc/render-config.sh, which rootfs/build.sh
# runs before staging the overlay. It is generated rather than committed so the
# template stays the single source of truth and the rendered file cannot drift
# away from it.
rootfs/overlay/etc/rauc/system.conf

# The image's RAUC keyring is STAGED from ca/ by rootfs/build.sh, which
# refuses one found in the overlay -- the overlay is not a source of trust.
# The entry stays so that a copy left over from before that rule can never be
# committed into the one directory the build copies wholesale into the image.
rootfs/overlay/etc/rauc/keyring.pem

# Built by pkgs/rauc/build.sh, like pkgs/podman/out-*: compiled artefacts, not source.
pkgs/rauc/out-*/
pkgs/rauc/versions.lock

# Repository-local scratch, shared with containers as a bind-mount root. All
# throwaway compile, verify and container-exchange paths belong here.
#
# NOT the system /tmp: the docker daemon does not share this session's /tmp, so
# a bind mount of it succeeds and delivers an empty directory. Named tmp/ and
# not runtime/ because a real runtime directory would then be silently ignored,
# and because the harness measurements quote paths like /srv/bkd/runtime/bun
# that have nothing to do with this one.
tmp/
