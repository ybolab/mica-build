talos/
out/
board/*/out/
_out/

# Development TUF signing keys, generated by `mos-sign gen-dev-keys`.
# Key material is never committed.
update/sign/.devkeys/

# Development RAUC bundle signing material, generated by
# os/rauc/gen-dev-keys.sh. Key material is never committed; a committed signing
# key would make every device trust anything anyone builds.
os/rauc/.devkeys/

# Optional local RAUC keyring for developer images: a copy of a dev CA cert
# dropped in so a locally built image can install locally built bundles.
os/rootfs/overlay-v2/etc/rauc/keyring.pem
