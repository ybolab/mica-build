# mos-required kernel options — the board-independent Talos runtime baseline,
# shared by every board (board/common/, referenced as buildx named context
# `mos-common`). Board kernels merge this BEFORE olddefconfig and assert every
# =y line against the final .config. dm-verity no-initramfs boot cannot load
# modules, so these must be built-in =y, never =m. Board-specific requirements
# (storage controller, etc.) belong in the board's own config, not here.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y

# machined early boot fsopen()s these pseudo filesystems unconditionally
# (internal/pkg/mount/v3/helpers.go in the talos repo); a missing one causes
# "early boot failed: openfs failed" and a reboot loop (seen on hardware
# 2026-08-17: hugetlbfs). SELinux is permissive by default (DEVELOP=y);
# machined decides enforcing per machine config.
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
# tracefs has NO Kconfig symbol of its own — fs/tracefs is built by
# CONFIG_TRACING (selected by the baseline's FUNCTION_TRACER). The line below
# is an assertion only.
CONFIG_TRACING=y
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
# SELinux must also be in the LSM boot list or selinuxfs never registers
# (compiled-but-inactive); string option, not covered by the =y assertion loop.
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,selinux,bpf"
