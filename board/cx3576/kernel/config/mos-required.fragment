# mos-required kernel options — single source of truth, consumed by the
# Talos image phase for dm-verity boot. dm-verity no-initramfs boot cannot
# load modules, so these must be built-in =y, never =m.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y

# machined early boot fsopen()s these pseudo filesystems unconditionally
# (internal/pkg/mount/v3/helpers.go in the talos repo); a missing one causes
# "early boot failed: openfs failed" and a reboot loop (seen on hardware
# 2026-08-17: hugetlbfs). SELinux is permissive by default (DEVELOP=y);
# machined decides enforcing per machine config.
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
# TRACEFS is promptless (only reachable via select from TRACING);
# ENABLE_DEFAULT_TRACERS (nop tracer, minimal overhead) is the visible knob
# that pulls it in. The TRACEFS=y line stays as the build assertion.
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_TRACEFS=y
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
