# mos-required kernel options — the board-independent runtime baseline, shared
# by every board (boards/common/, referenced as the buildx named context
# `mos-common`). Board kernels merge this before olddefconfig and assert every
# =y line against the final .config. dm-verity no-initramfs boot cannot load
# modules, so these must be built-in =y, never =m. Board-specific requirements
# (storage controller, etc.) belong in the board's own config, not here.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
# Without XATTR support a squashfs root silently drops file capabilities and
# security xattrs (e.g. Debian's cap_net_raw on ping).
CONFIG_SQUASHFS_XATTR=y
CONFIG_OVERLAY_FS=y

# Inherited from the baseline as "machined-era options
# (harmless) + WireGuard", and retained deliberately: nothing in the shipping
# image requires them. A missing hugetlbfs put the board in a reboot loop on
# hardware (2026-08-17). SELinux is permissive: CONFIG_SECURITY_SELINUX_DEVELOP=y
# and no shipping process changes that.
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
# tracefs has NO Kconfig symbol of its own — fs/tracefs is built by
# CONFIG_TRACING (selected by the baseline's FUNCTION_TRACER). The line below
# is an assertion only.
CONFIG_TRACING=y
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
# SELinux must also be in the LSM boot list or selinuxfs never registers
# (compiled-but-inactive); string option, not covered by the =y assertion loop.
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,selinux,bpf"

# Fleet remote-management tunnel (systemd-networkd native netdev support).
CONFIG_WIREGUARD=y

# Product requirements, not vendor defaults. Both are already =y in
# the cx3576 vendor config (kernel-cx3576z.config) and BRIDGE is
# additionally asserted in the board Dockerfile; stating them HERE makes the
# shared, per-board-asserted floor the thing that guarantees them, so a vendor
# config regenerated from upstream cannot drop either one silently.
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE=y

# Container networking (podman/netavark) -- an engine fact, not a board fact,
# so it is floor, not per-board configuration: netavark creates the
# container/host veth pair and programs `fib daddr type local` in an inet
# table, which needs the fib expression for both address families and their
# shared core. The per-symbol citations into the pinned netavark source live
# in tests/netavark-kernel-config-test.sh; the same set was measured
# missing on hardware (s905x5m, cx3576 baseline) as the reason bridge
# networking failed. x64 runs Debian's kernel, where these ship as modules --
# verify/src/checks-kernel.ts asserts that off the built image.
CONFIG_VETH=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
