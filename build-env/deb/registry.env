# The package registry every repository of this project publishes to and the
# assembly fetches from. Plain KEY=value, no logic; sourced by
# build-env/deb/{fetch,lock,publish,source}.sh after the same shape check
# build.sh applies to producer.env.
#
# The Debian registry of the `ybolab` organisation on the internal Gitea. One
# distribution (`mica`); the component of an archive is the repository that
# built it, which is also what its Mos-Source-Repo control field says.
MOS_REGISTRY_URL=https://git.ds.cc/api/packages/ybolab/debian
MOS_REGISTRY_DIST=mica
# The environment variable that holds the API token (never the token itself).
# Every refusal on 401/403 names this variable rather than printing a value.
MOS_REGISTRY_TOKEN_VAR=GITEA_DS_TOKEN
# Where source.sh clones a package repository from, <prefix>/<component>.git:
# the ybolab organisation on GitHub, which hosts every Mica OS repository
# (the registry above stays on the internal Gitea, which has a Debian
# package registry; GitHub has none).
MOS_SOURCE_URL=git@github.com:ybolab
