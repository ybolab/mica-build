[Unit]
Description=mos API daemon (serves the web dashboard)
After=network.target mosd.service
Wants=mosd.service
# StateDirectory below lives under /var/lib; apid persists its TLS material
# there and must not start against an unmounted STATE.
RequiresMountsFor=/var/lib/mos

[Service]
Type=simple
ExecStart=/usr/bin/apid
Restart=on-failure
StateDirectory=mos/apid

# Sandboxing for the network-facing daemon. apid stays root to bind 80/443
# and to read its StateDirectory, but it execs nothing, needs no home, no
# realtime, no writable-executable mappings, and speaks only unix (bus to
# mosd) and inet sockets.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
