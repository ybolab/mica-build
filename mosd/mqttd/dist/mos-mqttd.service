[Unit]
Description=mos MQTT bridge (publishes the com.mos.Item1 item tree)
Documentation=file:///usr/share/doc/mos/bus.md
After=network.target mosd.service
Wants=mosd.service

[Service]
Type=simple

# WHERE THE BROKER IS CONFIGURED, AND WHY IT IS NOT THIS FILE.
# The root filesystem is an immutable dm-verity squashfs: this unit cannot be
# edited on the device, and `systemctl edit` has nowhere to write. A broker
# address baked in here would be a broker address fixed at image build time,
# identical on every device flashed with the image. So the address is read
# from STATE instead, and this file carries only the fallbacks.
#
# To point the bridge at a broker, write /var/lib/mos/mqttd.env (a STATE-backed
# bind, so it survives a reboot and an A/B update) and restart the unit:
#
#     MOS_MQTT_BROKER_HOST=10.0.0.2
#     MOS_MQTT_BROKER_PORT=1883
#     MOS_MQTT_CLIENT_ID=mos-<serial>
#     MOS_MQTT_MODE=read-only
#
# The leading `-` on EnvironmentFile makes an absent file a non-error: an
# unconfigured device runs on the defaults below rather than failing to start.
Environment=MOS_MQTT_BROKER_HOST=localhost
Environment=MOS_MQTT_BROKER_PORT=1883
Environment=MOS_MQTT_CLIENT_ID=mos-mqttd
Environment=MOS_MQTT_MODE=read-only
EnvironmentFile=-/var/lib/mos/mqttd.env

# Read-only by default: the bridge is a data publisher unless someone
# deliberately makes it a control path (MOS_MQTT_MODE=full carries W topics
# through to SetValue). The default is restated in the binary's own clap
# default, so a wiped environment cannot silently promote the bridge.
ExecStart=/usr/bin/mos-mqttd \
    --mode ${MOS_MQTT_MODE} \
    --broker-host ${MOS_MQTT_BROKER_HOST} \
    --broker-port ${MOS_MQTT_BROKER_PORT} \
    --client-id ${MOS_MQTT_CLIENT_ID}
Restart=on-failure
RestartSec=5

# IDENTITY: a STATIC system user, not DynamicUser.
#
# This unit used DynamicUser=yes until the bridge was wired into the image,
# and the wiring is what showed the problem. com.mos.mosd is a ROOT-ONLY bus
# name (mosd/dist/com.mos.mosd.conf, RFCT-048): the default context DENIES
# both send_destination and receive_sender. A dynamic uid is therefore refused
# by that policy, and the bridge would start, connect to the broker and
# publish nothing at all -- a failure with no error at the point of cause.
#
# The fix is a D-Bus grant, and a grant needs an identity to name.
# <policy user="..."> resolves its user when dbus-daemon reads the file at
# startup, which is before any dynamic user for this unit exists, so a
# DynamicUser name cannot be granted anything: the rule would parse, load, and
# match nothing. A rule that cannot match is worse than a missing rule --
# it reads, in a diff and in a review, exactly like a working grant.
#
# So: a static system user with a pinned uid/gid, granted exactly three
# members in mosd/dist/mos-mqttd.conf. Everything DynamicUser was providing
# implicitly is stated explicitly below instead.
User=mos-mqttd
Group=mos-mqttd

# Sandboxing. The bridge is a pure bus client with one outbound TCP
# connection: it owns no state, writes no files, execs nothing, and needs
# neither root nor any capability. It is the most exposed daemon in the image
# -- the only one that speaks to the network -- and is confined accordingly.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# DynamicUser=yes implied these two. Stated now that it is gone.
RemoveIPC=yes
UMask=0077

[Install]
WantedBy=multi-user.target
