# The `board-cx3576` producer: the cx3576 board package, `mos-board-cx3576`.
#
# Plain `KEY=value` lines only: no logic, no command substitution, no
# expansion. Safe to source from bash and to parse with grep/sed from anything
# else, and checked for that shape by os/rootfs/packages-src/build-deb.sh
# before it is sourced. os/rootfs/packages-src/README.md documents every field.
#
# Run this producer through os/boards/cx3576/deb/render.sh, not by invoking the
# driver directly: the `stage` context below is filled by that script from
# ${BOARD_DIR:-os/boards/cx3576/bsp}, and it is where the kernel modules, the
# selected firmware, the boot inputs and the rendered configuration arrive.
# Calling build-deb.sh with the context missing is refused by name.

PACKAGES="mos-board-cx3576"

# `arm64` and nothing else. This is one board's payload -- its kernel modules
# are built for the RK3576 and its boot inputs are that SoC's -- so there is no
# architecture-independent rendering of it, and `all` would declare a package
# every x64 image could install.
ARCHES="arm64"

# The main build context is os/rootfs/packages-src (the driver passes its own
# directory), which holds nothing this producer uses; Dockerfile.dockerignore
# excludes all of it. Everything comes over as a named context.
#
# The committed trees are named directly rather than relayed through `stage`,
# so the payload's provenance is the repository path in this line. `stage` is
# the exception, and only for what BOARD_DIR selects: a fixed path is the only
# thing this file can hold.
#
# NOT os/boards/cx3576 as one context: os/boards/*/bsp/out is a gitignored
# build tree that reaches hundreds of megabytes, and buildkit would hash and
# transfer it on every build to copy four files out of it.
BUILD_CONTEXTS="boarddeb=os/boards/cx3576/deb stage=tmp/mos-board-cx3576-deb hwinit=os/boards/cx3576/hwinit boardinit=os/boards/cx3576/bsp/init boardoverlay=os/boards/cx3576/overlay"
