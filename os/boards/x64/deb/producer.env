# The `board-x64` producer: the mos-board-x64 package.
#
# Plain `KEY=value` lines only: no logic, no command substitution, no
# expansion. Safe to source from bash and to parse with grep/sed from anything
# else, and checked for that shape by os/rootfs/packages-src/build-deb.sh
# before it is sourced. os/rootfs/packages-src/README.md documents every field.

# One package: the x64 board's rendered configuration, its verity initramfs
# payload, grub-editenv and the GRUB configuration the finalizer assembles the
# ESP from.
PACKAGES="mos-board-x64"

# amd64 only, and not `all`. The payload carries /usr/bin/grub-editenv, an
# amd64 ELF taken out of Debian's grub-common, and the board it configures is
# the x86_64 one -- os/boards/x64/board.env declares MOS_ARCH=amd64. An `all`
# archive would install on the cx3576 image, whose layout none of these files
# describes.
ARCHES="amd64"

# Everything this producer stages, and none of it is in the driver's own
# context (os/rootfs/packages-src). The board directory carries the layout, the
# GRUB configuration, the board overlay and this producer's own files; the
# other three are the shared sources whose bytes the package must reproduce.
#
# `rauc` and `overlay` are here because os/pkgs/rauc/render-config.sh is
# INVOKED rather than reimplemented: it derives the RAUC status file's location
# by matching the META GUID in the shared fstab template, so the renderer and
# that template travel together.
BUILD_CONTEXTS="board=os/boards/x64 rauc=os/pkgs/rauc overlay=os/rootfs/overlay-v2 initramfs=os/rootfs/initramfs"

# The pinned Debian trixie base, for the stage that takes grub-editenv out of
# grub-common. The same release os/rootfs/stages/10-base.Dockerfile assembles
# the device root from, which is what makes the extracted binary's libraries
# the ones the image carries.
FROM_IMAGES="MOS_IMAGE_DEBIAN_TRIXIE"
