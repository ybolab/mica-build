#!/bin/sh
# Attach the Bluetooth HCI configured in /etc/mos/bt.conf (uart=, proto=).
# Unblocks the bluetooth rfkill, then execs btattach (long-running; the unit
# is Type=simple). Best-effort: a missing conf or UART exits 0 silently; a
# failed btattach fails only the mos-bt unit, which nothing depends on.
CONF=/etc/mos/bt.conf
[ -r "$CONF" ] || exit 0
conf_get() { sed -n "s/^$1=//p" "$CONF" | head -n1; }
uart=$(conf_get uart)
proto=$(conf_get proto)
[ -n "$uart" ] && [ -e "$uart" ] || exit 0
rfkill unblock bluetooth 2>/dev/null || true
exec btattach -B "$uart" -P "${proto:-bcm}"
