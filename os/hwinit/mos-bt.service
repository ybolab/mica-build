[Unit]
Description=Attach Bluetooth HCI over UART
ConditionPathExists=/etc/mos/bt.conf

[Service]
# btattach is long-running, so this is a plain simple service. Best-effort:
# nothing depends (or may depend) on it, so a failed attach fails only this
# unit and never the boot. No Restart= — one attempt per boot, no retry loop.
Type=simple
ExecStart=/usr/lib/mos/hwinit-bt

[Install]
WantedBy=multi-user.target
