# The RAUC producer: the `mos-rauc` package, out of the pinned upstream RAUC
# source os/pkgs/rauc/versions.env names. Read by os/build-env/deb/producers.sh
# and os/build-env/deb/build.sh; the convention is documented in
# os/build-env/deb/README.md.
PACKAGES="mos-rauc"

# This producer repacks upstream RAUC, so its archive carries the upstream
# version in front of the pool's git stamp: mos-rauc_1.13+git<commit>-1, not
# the workspace's 0.1.0. The key is the same one the compile is pinned by.
VERSION_FROM="os/pkgs/rauc/versions.env:RAUC_VERSION"

# NOT `all`. The payload's largest member is an ELF binary compiled for the
# target, and dpkg-shlibdeps has to resolve it against that architecture's
# libraries; one archive shared by both pools would carry one architecture's
# soname versions for both.
ARCHES="amd64 arm64"

# NO ENABLEMENT LINK, and the zero is the declaration of that rather than a gap
# in this file. os/rootfs/scripts/rauc-install.sh installs five files and
# creates no multi-user.target.wants symlink, and no other script under
# os/rootfs/ names rauc.service either -- the daemon is reached through D-Bus
# activation, which is what de.pengutronix.rauc.service in this payload is for:
# it names SystemdService=rauc.service and the bus asks systemd for the unit on
# the first method call. A wants symlink here would start the update daemon at
# every boot, which is not what the image does today.
ENABLEMENT="mos-rauc=0"

# The upstream source build. It is a compile rather than a docker build of this
# producer's own, so it cannot be a key above: os/pkgs/rauc/build.sh already
# drives os/pkgs/rauc/Dockerfile with the -Dnetwork=false -Dstreaming=false
# options os/pkgs/rauc/versions.env exists to justify, and this producer must
# not be a second place those options live.
PREPARE="prepare.sh"

FROM_IMAGES="MOS_BUILD_DEB=LOCAL_MOS_BUILD_DEB"

# `scripts` is os/rootfs/scripts/, for rauc-assert-no-tls-stack.sh alone. The
# no-second-TLS assertion is REUSED rather than restated here: a copy of it in
# this producer would be a second version of the claim that can drift from the
# one the image stage runs.
BUILD_CONTEXTS="scripts=os/rootfs/scripts"
