# syntax=docker/dockerfile:1
# =============================================================================
# os/rootfs — Debian systemd arm64 rootfs for cx3576, layout v2 (PLAN-010 M4)
#
#   bash os/rootfs/build-v2.sh
#   → _out/cx3576/rootfs-verity.img     squashfs-zstd + appended verity hash tree
#   → _out/cx3576/rootfs-verity.env     verity parameters for the assembler/cmdline
#   → _out/cx3576/rootfs-report-v2.txt  package list + installed size
#
# Sibling of ./Dockerfile, not a replacement: v1 keeps building the writable
# single-slot ext4 root and is not touched by this file. The rootfs stage is
# v1's content plus what a read-only A/B root needs (RAUC, libubootenv, the
# overlay-v2 mount wiring); the pack stage swaps mke2fs for mksquashfs +
# veritysetup.
#
# Build context = repo root. Depends on board/cx3576/out/kernel/modules.tar and
# on the rendered overlay tree, both staged into the context by build-v2.sh.
# Executes arm64 binaries: on x86 hosts install emulation once with
#   docker run --privileged --rm tonistiigi/binfmt --install arm64
# =============================================================================

# ---------------------------------------------------------------------------
# Root filesystem: Debian bookworm + systemd
# ---------------------------------------------------------------------------
FROM --platform=linux/arm64 debian:bookworm-slim AS rootfs

# Strict package allowlist — add nothing here without documenting it in README.md.
# v2 additions over v1: rauc (update client, RFCT-014) and libubootenv-tool
# (fw_printenv/fw_setenv — RAUC's U-Boot backend and the machine-id oneshot of
# RFCT-015). squashfs-tools and cryptsetup-bin are deliberately absent: packing
# the root is a build-stage job, and the kernel opens the verity device from
# the cmdline without any userspace tool.
RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd \
        systemd-sysv \
        systemd-resolved \
        udev \
        dbus \
        kmod \
        openssh-server \
        iproute2 \
        bluez \
        rfkill \
        rauc \
        libubootenv-tool \
    && rm -rf /var/lib/apt/lists/*

# Kernel modules. Debian is merged-usr (/lib -> usr/lib) and the tar's paths
# start with lib/, so it cannot be ADDed to / directly — extract to a temp dir
# and copy into /usr/lib/modules. dep files are inside the tar; no depmod needed.
ARG MODULES_TAR
COPY ${MODULES_TAR} /tmp/modules.tar
RUN mkdir -p /tmp/mods /usr/lib/modules && \
    tar -xf /tmp/modules.tar -C /tmp/mods && \
    cp -a /tmp/mods/lib/modules/. /usr/lib/modules/ && \
    rm -rf /tmp/mods /tmp/modules.tar

# WiFi/BT firmware (AP6275S / AIC8800D80 dual SKU). Driver loading is done by
# the mos-modules unit (best-effort, silent on the absent SKU) instead of
# modules-load.d. The brcm/ symlink serves the BT patchram: the btbcm driver
# identifies the AP6275S BT core (BCM43752A2) as BCM4362A2 and requests
# brcm/BCM4362A2.hcd, which resolves to the vendor SYN43756B0.hcd blob.
COPY board/cx3576/rootfs/firmware/ /usr/lib/firmware/
RUN ln -sf fw_bcm43752a2_ag.bin /usr/lib/firmware/fw_bcmdhd.bin && \
    ln -sf nvram_ap6275s.txt /usr/lib/firmware/nvram.txt && \
    ln -sf clm_bcm43752a2_ag.blob /usr/lib/firmware/clm_bcmdhd.blob && \
    mkdir -p /usr/lib/firmware/brcm && \
    ln -sf ../SYN43756B0.hcd /usr/lib/firmware/brcm/BCM4362A2.hcd

# Networking: DHCP on all eth* (kernel cmdline has net.ifnames=0)
RUN printf '%s\n' \
        '[Match]' \
        'Name=eth*' \
        '' \
        '[Network]' \
        'DHCP=yes' \
        > /etc/systemd/network/80-dhcp.network && \
    { systemctl enable systemd-networkd systemd-resolved ssh || true; } && \
    mkdir -p /etc/systemd/system/multi-user.target.wants && \
    for u in systemd-networkd systemd-resolved ssh; do \
        [ -L "/etc/systemd/system/multi-user.target.wants/$u.service" ] || \
            ln -s "/lib/systemd/system/$u.service" \
                  "/etc/systemd/system/multi-user.target.wants/$u.service"; \
    done && \
    test -L /etc/systemd/system/multi-user.target.wants/systemd-networkd.service && \
    test -L /etc/systemd/system/multi-user.target.wants/systemd-resolved.service && \
    test -L /etc/systemd/system/multi-user.target.wants/ssh.service
# /etc/resolv.conf cannot be replaced here (bind-mounted by buildkit during RUN);
# the stub-resolv.conf symlink is created in the pack stage instead. It points
# into /run, so it stays writable with / read-only.

# sshd host keys are NOT baked in. The openssh-server postinst generates a set
# at build time; on a signed, byte-identical rootfs that would be a host key
# shared by every device, and a random keygen would make the verity root hash
# differ on every cold build. mos-seed-state generates them per device into
# STATE instead (see overlay-v2/usr/lib/mos/mos-seed-state).
RUN rm -f /etc/ssh/ssh_host_*

# Read-only root wiring: fstab (EPHEMERAL /var, STATE, META, tmpfs /tmp),
# the repart.d set that grows EPHEMERAL, the two STATE bind mounts, the
# first-boot seed oneshots and the fw_env.config pointing at the uenv pair.
# The tree is rendered from os/layout/cx3576-v2.env by build-v2.sh; nothing
# here duplicates a layout constant. Modes are set explicitly so the packed
# image cannot inherit a host umask.
ARG OVERLAY_DIR
COPY ${OVERLAY_DIR}/ /tmp/overlay/
RUN cp -a /tmp/overlay/. / && \
    rm -rf /tmp/overlay && \
    chmod 0755 /usr/lib/mos/mos-seed-var /usr/lib/mos/mos-seed-state && \
    chmod 0644 /etc/fstab /etc/fw_env.config /etc/repart.d/*.conf \
               /etc/systemd/system/mos-seed-*.service \
               /etc/systemd/system/var-lib-mos.mount \
               /etc/systemd/system/etc-ssh.mount && \
    mkdir -p /mnt/state /mnt/meta /etc/systemd/system/local-fs.target.wants \
             /etc/systemd/system/timers.target.wants && \
    for u in mos-seed-var.service mos-seed-state.service var-lib-mos.mount etc-ssh.mount; do \
        ln -sf "/etc/systemd/system/$u" "/etc/systemd/system/local-fs.target.wants/$u" && \
        test -L "/etc/systemd/system/local-fs.target.wants/$u"; \
    done && \
    ln -sf /lib/systemd/system/fstrim.timer \
           /etc/systemd/system/timers.target.wants/fstrim.timer && \
    test -L /etc/systemd/system/timers.target.wants/fstrim.timer

# mosd management daemon: binary + systemd unit (enabled) + D-Bus system policy.
# build-v2.sh always stages MOSD_DIR (empty when WITH_MOSD=0), so the COPY works
# on both paths and the RUN installs only when the binary was staged.
# /var/lib/mos is the bind target of var-lib-mos.mount; mosd's own paths are
# unchanged from v1.
ARG MOSD_DIR
ARG WITH_MOSD=1
COPY ${MOSD_DIR}/ /tmp/mosd/
RUN if [ "$WITH_MOSD" = "1" ] && [ -f /tmp/mosd/mosd ]; then \
        install -m 0755 /tmp/mosd/mosd /usr/bin/mosd && \
        install -m 0644 /tmp/mosd/mosd.service /usr/lib/systemd/system/mosd.service && \
        install -m 0644 /tmp/mosd/com.mos.mosd.conf /usr/share/dbus-1/system.d/com.mos.mosd.conf && \
        mkdir -p /var/lib/mos /etc/systemd/system/multi-user.target.wants && \
        ln -sf /usr/lib/systemd/system/mosd.service \
               /etc/systemd/system/multi-user.target.wants/mosd.service && \
        test -L /etc/systemd/system/multi-user.target.wants/mosd.service; \
    fi && \
    if [ "$WITH_MOSD" = "1" ] && [ -f /tmp/mosd/webd ]; then \
        install -m 0755 /tmp/mosd/webd /usr/bin/webd && \
        install -m 0644 /tmp/mosd/webd.service /usr/lib/systemd/system/webd.service && \
        mkdir -p /etc/systemd/system/multi-user.target.wants && \
        ln -sf /usr/lib/systemd/system/webd.service \
               /etc/systemd/system/multi-user.target.wants/webd.service && \
        test -L /etc/systemd/system/multi-user.target.wants/webd.service; \
    fi && rm -rf /tmp/mosd

# Board hardware init: generic best-effort oneshots (os/hwinit, board-agnostic
# mechanism) + per-board facts staged from BOARD_DIR/init into /etc/mos.
# BOARD_INIT_DIR may be an empty dir (boards without hw-init facts): every unit
# is condition-gated on its conf file, so enabling them is safe either way.
ARG BOARD_INIT_DIR
COPY os/hwinit/ /tmp/hwinit/
COPY ${BOARD_INIT_DIR}/ /tmp/board-init/
RUN mkdir -p /etc/mos /usr/lib/mos /etc/systemd/system/multi-user.target.wants && \
    cp -a /tmp/board-init/. /etc/mos/ && \
    install -m 0755 /tmp/hwinit/hwinit-* /usr/lib/mos/ && \
    install -m 0644 /tmp/hwinit/*.service /usr/lib/systemd/system/ && \
    for u in mos-modules mos-otg mos-can mos-bt; do \
        ln -sf "/usr/lib/systemd/system/$u.service" \
               "/etc/systemd/system/multi-user.target.wants/$u.service" && \
        test -L "/etc/systemd/system/multi-user.target.wants/$u.service"; \
    done && \
    rm -rf /tmp/hwinit /tmp/board-init

# journald in RAM only, as in v1. /var is writable under v2, so persistent
# journal is now possible, but enabling it is a separate decision (flash wear,
# log retention policy) and is left to a follow-up.
RUN mkdir -p /etc/systemd/journald.conf.d && \
    printf '%s\n' '[Journal]' 'Storage=volatile' \
        > /etc/systemd/journald.conf.d/00-volatile.conf

# Identity files (/etc/hostname, /etc/hosts, /etc/machine-id) are written in the
# pack stage: buildkit bind-mounts them during RUN, so writes here would be lost.

# Serial console getty: intentionally none — systemd's getty-generator spawns
# serial-getty@ttyFIQ0 automatically from the kernel console= parameter.

# DEV profile only — never set ROOT_PASSWORD for production images.
# Default (empty): root stays locked and PermitRootLogin is untouched.
ARG ROOT_PASSWORD=""
RUN if [ -n "$ROOT_PASSWORD" ]; then \
        echo "root:${ROOT_PASSWORD}" | chpasswd && \
        mkdir -p /etc/ssh/sshd_config.d && \
        printf 'PermitRootLogin yes\n' > /etc/ssh/sshd_config.d/10-dev.conf; \
    fi

# Build report (moved out of the tree by the pack stage; never ships in the
# image). Must run before the pack stage relocates /var, since dpkg-query
# reads /var/lib/dpkg.
RUN { dpkg-query -W -f='${Package}\t${Installed-Size}\n'; \
      echo; \
      echo "TOTAL_MB $(du -sxm --exclude=/proc --exclude=/sys --exclude=/dev / 2>/dev/null | cut -f1)"; \
    } > /rootfs-report.txt

# ---------------------------------------------------------------------------
# Pack: squashfs-zstd + appended dm-verity hash tree
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS pack
RUN apt-get update && apt-get install -y --no-install-recommends \
        squashfs-tools cryptsetup-bin libcap2-bin \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rootfs / /rootfs/

# Tree surgery that cannot happen in the rootfs stage, either because buildkit
# bind-mounts the file during RUN or because it would break dpkg.
#  - /etc/resolv.conf -> /run, the only writable place with / read-only.
#  - /etc/machine-id must EXIST and be empty: systemd cannot write it on a
#    read-only /etc, and falls back to bind-mounting a transient id from /run
#    over it. RFCT-018's U-Boot passes systemd.machine_id= to make it stable.
#  - /var becomes an empty mountpoint for EPHEMERAL; the built tree moves to
#    /usr/share/factory/var, from where mos-seed-var restores it on first boot.
RUN mkdir -p /out && \
    mv /rootfs/rootfs-report.txt /out/rootfs-report-v2.txt && \
    ln -sf ../run/systemd/resolve/stub-resolv.conf /rootfs/etc/resolv.conf && \
    echo 'mos' > /rootfs/etc/hostname && \
    echo '127.0.1.1 mos' >> /rootfs/etc/hosts && \
    : > /rootfs/etc/machine-id && \
    mkdir -p /rootfs/usr/share/factory && \
    mv /rootfs/var /rootfs/usr/share/factory/var && \
    mkdir -m 0755 /rootfs/var

# Privilege inventory. mksquashfs runs with -all-root (mandated: it removes the
# build container's uid/gid map from the image), which rewrites ownership but
# not mode bits — so any setgid binary becomes setgid-root. File capabilities
# depend on xattrs surviving both the buildkit layer export and
# CONFIG_SQUASHFS_XATTR in the kernel. Both are recorded here rather than
# assumed, so a regression is visible in the report.
RUN { echo; \
      echo "== setuid/setgid =="; \
      find /rootfs -xdev -type f -perm /6000 -printf '%M %u:%g %P\n' 2>/dev/null | sort; \
      echo; \
      echo "== file capabilities =="; \
      getcap -r /rootfs 2>/dev/null | sed 's|^/rootfs||' | sort; \
    } >> /out/rootfs-report-v2.txt

# Pack. Every knob that would otherwise vary between builds is pinned:
#   -processors 1   multi-threaded mksquashfs is NOT byte-reproducible
#   -mkfs-time/-all-time  no wall clock in the superblock or in any inode
#   -all-root       no build-container uid/gid map
#   -noappend       never merge into a pre-existing image
#   -no-exports     drop the NFS export table (unused, extra bytes)
# veritysetup gets the pinned salt and a pinned UUID: both default to random
# values, and the UUID lands in the verity superblock at the hash offset, so
# leaving it unset alone would make the image differ on every run.
# The hash tree is appended to the squashfs in the same file via --hash-offset,
# and the result is padded to a whole MiB because the image assembler dd's it
# into the slot at a MiB boundary.
ARG VERITY_SALT
ARG VERITY_UUID
ARG SQUASHFS_TIME
ARG VERITY_HASH_ALGO=sha256
ARG VERITY_DATA_BLOCK_SIZE=4096
ARG VERITY_HASH_BLOCK_SIZE=4096
RUN set -eu; \
    test -n "${VERITY_SALT}" && test -n "${VERITY_UUID}" && test -n "${SQUASHFS_TIME}"; \
    mksquashfs /rootfs /out/rootfs.squashfs \
        -comp zstd -Xcompression-level 19 \
        -noappend -all-root -no-exports \
        -mkfs-time "${SQUASHFS_TIME}" -all-time "${SQUASHFS_TIME}" \
        -processors 1; \
    sq_bytes="$(stat -c %s /out/rootfs.squashfs)"; \
    if [ $((sq_bytes % VERITY_DATA_BLOCK_SIZE)) -ne 0 ]; then \
        echo "error: squashfs size ${sq_bytes} is not a multiple of ${VERITY_DATA_BLOCK_SIZE}" >&2; exit 1; \
    fi; \
    data_blocks=$((sq_bytes / VERITY_DATA_BLOCK_SIZE)); \
    hash_start_block=$((sq_bytes / VERITY_HASH_BLOCK_SIZE)); \
    cp /out/rootfs.squashfs /out/rootfs-verity.img; \
    root_hash="$(veritysetup format /out/rootfs-verity.img /out/rootfs-verity.img \
        --hash="${VERITY_HASH_ALGO}" \
        --data-block-size="${VERITY_DATA_BLOCK_SIZE}" \
        --hash-block-size="${VERITY_HASH_BLOCK_SIZE}" \
        --data-blocks="${data_blocks}" \
        --hash-offset="${sq_bytes}" \
        --salt="${VERITY_SALT}" \
        --uuid="${VERITY_UUID}" \
        | awk '/^Root hash:/ { print $NF }')"; \
    test -n "${root_hash}"; \
    raw_bytes="$(stat -c %s /out/rootfs-verity.img)"; \
    image_bytes=$(( (raw_bytes + 1048575) / 1048576 * 1048576 )); \
    truncate -s "${image_bytes}" /out/rootfs-verity.img; \
    rm -f /out/rootfs.squashfs; \
    { echo "VERITY_ROOT_HASH=${root_hash}"; \
      echo "VERITY_SALT=${VERITY_SALT}"; \
      echo "VERITY_UUID=${VERITY_UUID}"; \
      echo "VERITY_HASH_ALGO=${VERITY_HASH_ALGO}"; \
      echo "VERITY_DATA_BLOCK_SIZE=${VERITY_DATA_BLOCK_SIZE}"; \
      echo "VERITY_HASH_BLOCK_SIZE=${VERITY_HASH_BLOCK_SIZE}"; \
      echo "VERITY_DATA_BLOCKS=${data_blocks}"; \
      echo "VERITY_HASH_START_BLOCK=${hash_start_block}"; \
      echo "VERITY_DATA_SECTORS=$((sq_bytes / 512))"; \
      echo "SQUASHFS_BYTES=${sq_bytes}"; \
      echo "IMAGE_BYTES=${image_bytes}"; \
    } > /out/rootfs-verity.env; \
    echo "pack: squashfs ${sq_bytes} B + verity -> ${raw_bytes} B -> padded ${image_bytes} B"; \
    echo "pack: root hash ${root_hash}"

FROM scratch AS artifact
COPY --from=pack /out/rootfs-verity.img /
COPY --from=pack /out/rootfs-verity.env /
COPY --from=pack /out/rootfs-report-v2.txt /
