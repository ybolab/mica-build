# /etc/fw_env.config — where fw_printenv/fw_setenv (libubootenv-tool) find the
# redundant U-Boot environment pair.
#
# Rendered from os/layout/cx3576-v2.env by os/rootfs/build-v2.sh. The pair is
# addressed by partition GUID rather than by a hardcoded /dev/mmcblk0 offset:
# the GUIDs are layout constants, the disk name is not.
#
# PROVISIONAL — RAUC's U-Boot backend is wired up by RFCT-014, which owns
# os/rauc/fw_env.config(.in) and may replace this file. Two writers exist for
# this environment (RAUC slot marking and the first-boot machine-id oneshot),
# and libubootenv gives no cross-process locking, so writes must never overlap.
#
# <device>                              <offset>  <env size>
/dev/disk/by-partuuid/@UENV_A_GUID@     0x0       @UENV_SIZE_HEX@
/dev/disk/by-partuuid/@UENV_B_GUID@     0x0       @UENV_SIZE_HEX@
