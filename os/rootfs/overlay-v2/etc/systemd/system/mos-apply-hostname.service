[Unit]
Description=Apply the persisted hostname
# PID 1 reads /etc/hostname and sets the kernel hostname long before any mount
# unit runs, so at that point it still sees the value baked into the squashfs.
# Once etc-hostname.mount has swapped in the STATE copy, the running hostname
# has to be re-applied or a hostname set through the web UI would silently
# revert to the image default on every reboot.
DefaultDependencies=no
Requires=etc-hostname.mount
After=etc-hostname.mount
Before=local-fs.target shutdown.target
Conflicts=shutdown.target
ConditionFileNotEmpty=/etc/hostname

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/hostname -F /etc/hostname

[Install]
WantedBy=local-fs.target
