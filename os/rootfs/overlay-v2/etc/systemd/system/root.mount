[Unit]
Description=Persistent root home directory from the DATA partition
# /root is where an operator working as root leaves things: shell history, a
# scratch script, a bundle downloaded for `rauc install`, an edited .bashrc.
# That is USER DATA of unbounded size, not configuration, and the two tiers are
# sized for exactly that difference. STATE is 64 MiB of small, precious
# identity -- the settings tree, the sshd host keys, the shadow file -- and a
# root home that filled it would take all of them down together. DATA is the
# only partition that carries x-systemd.growfs and the only one systemd-repart
# extends to the end of the disk, so it is the only tier a root home can live
# on without a ceiling.
#
# KEY LOGIN DOES NOT DEPEND ON THIS BIND. sshd reads
# /etc/ssh/authorized_keys.d/%u, never /root/.ssh/authorized_keys -- RFCT-034
# chose that path precisely because /root was ephemeral -- so a /root that
# fails to mount does not lock anyone out. The reverse is also worth knowing: a
# key written to /root/.ssh/authorized_keys now SURVIVES a reboot and still
# grants nothing, because AuthorizedKeysFile REPLACES the default locations
# rather than adding to them.
#
# The bind source is created by mos-seed-root, which must run BEFORE this unit:
# mount(8) does not create the source of a bind, and /root cannot be populated
# after the fact because the root filesystem is a read-only verity squashfs.
Requires=mos-seed-root.service
After=mos-seed-root.service
RequiresMountsFor=/srv

[Mount]
What=/srv/root
Where=/root
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
