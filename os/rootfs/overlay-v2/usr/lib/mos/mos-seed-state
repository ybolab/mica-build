#!/bin/sh
# Seed the STATE partition. Runs on EVERY boot, converging rather than
# stamping: missing directories and files are created, existing content is
# NEVER touched.
#
# There is deliberately no run-once stamp. The sibling mos-seed-home already
# rejects one, and the reasoning is the same A/B forward-compatibility fact:
# STATE outlives every rootfs that will ever be flashed, so a stamp written by
# the first image would stop a LATER image from seeding a STATE-backed
# directory it introduces — updated devices would mount a bind with no source
# and fail, while fresh devices worked, which is the worst kind of fleet skew.
# Convergent re-runs cost a few mkdir -p on a converged system and buy every
# future release its seeding for free.
#
# STATE is created empty by the image assembler and holds everything that must
# survive an A/B update: mosd's settings and the sshd host keys. Both are
# exposed to the rest of the system as bind mounts (var-lib-mos.mount and
# etc-ssh.mount), so their source directories have to exist before those mounts
# are attempted — hence a oneshot ordered before them rather than a tmpfiles
# rule, which would run far too late.
#
# The sshd configuration is copied out of the read-only squashfs while /etc/ssh
# still shows the image copy (this runs before the binds, on every boot). Host
# keys are NOT baked into the image: a signed rootfs is shared byte-for-byte by
# every device, so a baked host key would be a shared secret and would also
# make the verity root hash depend on a random keygen. They are generated here
# instead, once per device.
set -eu

# Earlier images stamped /mnt/state/.mos-state-seeded and gated this unit on
# it. The stamp is exactly the forward-compat bug described above, so a
# leftover one is removed: nothing reads it any more, and leaving it would
# invite a future "optimisation" to start honouring it again.
rm -f /mnt/state/.mos-state-seeded

mkdir -p /mnt/state/mos /mnt/state/ssh

# Bluetooth link keys are credentials and must outlive a /var wipe.
# bluez expects 0700 on this directory and refuses to use a laxer one.
mkdir -p /mnt/state/bluetooth
chmod 0700 /mnt/state/bluetooth
# -n (no-clobber): files the image ships that STATE does not yet have are
# carried across — including ones a NEWER image adds — while a per-device or
# operator-edited copy on STATE always wins over the image's. On bookworm's
# coreutils (9.1) a skipped file is silent and exit 0; the 9.2/9.3 releases
# changed and re-changed `cp -n` exit semantics, so a base-image bump must
# re-verify this line or every boot after the first fails the unit.
cp -an /etc/ssh/. /mnt/state/ssh/

# The two connd config directories, on the same reasoning as /etc/ssh: mosd's
# WiFi reconcilers render into them at runtime, and on v2 /etc is a read-only
# squashfs. The image copy is carried across first (both packages ship helper
# scripts there) so the bind does not hide anything the image provided.
# 0700 because both hold a pre-shared key in the clear once a device is
# configured -- the supplicant config carries every network's PSK and the
# hostapd config carries the AP key.
for d in wpa_supplicant hostapd; do
    mkdir -p "/mnt/state/$d"
    if [ -d "/etc/$d" ]; then cp -an "/etc/$d/." "/mnt/state/$d/"; fi
    chmod 0700 "/mnt/state/$d"
done

# The hostname has to be writable: mosd's reconciler sets it through
# systemd-hostnamed, which writes /etc/hostname. Seed it from the value baked
# into the image while /etc/hostname still shows the squashfs copy;
# etc-hostname.mount binds this file over it immediately afterwards.
[ -f /mnt/state/hostname ] || cp -a /etc/hostname /mnt/state/hostname

# /etc/shadow is a symlink to /var/lib/mos/shadow, so the device's password
# file has to exist on STATE before anything reads it. The same reasoning as the
# host keys just above applies to its contents: a signed rootfs is byte-identical
# on every device, so no hash may come out of the image. mos-shadow-reconcile
# populates it from /usr/share/factory/etc/shadow with every entry LOCKED, and
# runs again on every boot from mos-shadow-reconcile.service to pick up accounts
# a later image adds. It is given the /mnt/state path explicitly because
# var-lib-mos.mount has not bound that directory onto /var yet at this point.
/usr/lib/mos/mos-shadow-reconcile /mnt/state/mos/shadow

for t in rsa ecdsa ed25519; do
    key="/mnt/state/ssh/ssh_host_${t}_key"
    [ -f "$key" ] || ssh-keygen -q -t "$t" -f "$key" -N '' -C ''
done
chmod 0755 /mnt/state/ssh
chmod 0600 /mnt/state/ssh/ssh_host_*_key
chmod 0644 /mnt/state/ssh/ssh_host_*_key.pub

sync
