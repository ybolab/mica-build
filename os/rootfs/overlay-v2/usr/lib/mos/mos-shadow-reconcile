#!/bin/sh
# Build /etc/shadow in RAM from the copy the image ships.
#
# WHY IN RAM. mos supports exactly one kind of operator credential on the
# console: a TRANSIENT root password, set through the web UI and gone at the
# next boot. There is no persistent per-device password -- that model existed
# and was superseded (docs/design/access.md §4.2), because a password is a
# persistent credential with no rotation path.
#
# Given that, a shadow file on a partition that SURVIVES REBOOTS is wrong, not
# merely redundant. It made "transient" a PROTOCOL rather than a PROPERTY: the
# password was written to STATE, a marker was written beside it, and this
# script cleared it on the next boot. Nothing enforced that. This unit is
# `WantedBy=multi-user.target` and only `Before=` sshd -- no unit `Requires=`
# it -- so a failed, masked or reordered oneshot left the "transient" password
# live on disk with sshd starting anyway.
#
# /run is a tmpfs. A reboot clears the password because the memory is gone,
# which nothing can fail to do. And if this script does not run, /etc/shadow
# does not exist and PAM fails closed: the failure direction is now safe.
#
# It also removed a whole defect class. The marker had to sit "beside" the
# shadow file, and /etc/shadow was a symlink onto STATE, so the lexical sibling
# landed in the read-only squashfs -- mosd failed with os error 30 and apid
# answered 502, which meant the documented way back into a locked-out device
# did not work at all. With the file in RAM there is no marker and
# no next-boot protocol to get wrong.
#
# WHAT IS STILL RECONCILED. Every account in /etc/passwd must have a shadow
# entry, and any account the factory copy does not name gets one appended
# LOCKED. A signed rootfs is byte-identical across the fleet, so no usable hash
# may come out of the image; and a later A/B update that adds a system account
# must not leave it with no entry at all. That is why this rebuilds rather than
# seeds once.
set -eu

SHADOW="${1:-/run/mos/shadow}"
PASSWD="${MOS_SHADOW_PASSWD:-/etc/passwd}"
FACTORY="${MOS_SHADOW_FACTORY:-/usr/share/factory/etc/shadow}"

[ -f "$PASSWD" ] || { echo "no $PASSWD to reconcile against" >&2; exit 1; }
[ -f "$FACTORY" ] || { echo "no $FACTORY to build from" >&2; exit 1; }

dir="$(dirname "$SHADOW")"
mkdir -p "$dir"
chmod 0755 "$dir"

lock_entry() {
    echo "$1" | awk -F: -v OFS=: '{ if ($2 !~ /^[!*]/) $2 = "!"; print }'
}

tmp="${SHADOW}.build.$$"
trap 'rm -f "$tmp"' EXIT INT TERM

# FROM THE FACTORY COPY, EVERY BOOT. Not from whatever was there before: there
# is nothing to preserve, and rebuilding is what makes the transient password
# transient without a protocol.
: >"$tmp"
while IFS= read -r line; do
    [ -n "$line" ] || continue
    lock_entry "$line" >>"$tmp"
done <"$FACTORY"

# Rule: an account in /etc/passwd with no entry gets one, LOCKED.
added=0
while IFS=: read -r user _rest; do
    [ -n "$user" ] || continue
    if ! awk -F: -v u="$user" '$1 == u { found = 1 } END { exit !found }' "$tmp"; then
        printf '%s:!:20000:0:99999:7:::\n' "$user" >>"$tmp"
        added=$((added + 1))
        echo "shadow: added locked entry for '$user'"
    fi
done <"$PASSWD"

chgrp shadow "$tmp" 2>/dev/null || true
chmod 0640 "$tmp"
mv -f "$tmp" "$SHADOW"
trap - EXIT INT TERM

echo "shadow: built ${SHADOW} in RAM from ${FACTORY} (${added} account(s) appended locked)"
