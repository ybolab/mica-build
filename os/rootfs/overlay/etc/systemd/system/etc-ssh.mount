[Unit]
Description=sshd configuration and host keys from the STATE partition
# /etc is on the read-only squashfs and is replaced wholesale by every A/B
# update, so sshd's host keys have to live outside it or the device changes
# identity on each upgrade. Binding over a mountpoint does not write to the
# underlying read-only filesystem.
Requires=mos-seed-state.service
After=mos-seed-state.service
RequiresMountsFor=/mnt/state
Before=ssh.service

[Mount]
What=/mnt/state/ssh
Where=/etc/ssh
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
