# The `bluetooth` producer: the `mos-bluetooth` package.
#
# Plain `KEY=value` lines only: no logic, no command substitution, no
# expansion. Safe to source from bash and to parse with grep/sed from anything
# else, and checked for that shape by os/build-env/deb/build.sh before it is
# sourced. os/build-env/deb/README.md documents every field.

# One package, its own producer. Wi-Fi lives in os/rootfs/packages-src/wifi:
# a board chooses Wi-Fi and Bluetooth independently, and the producer split is
# what keeps selecting, declining and rebuilding one radio from touching the
# other. A combined `radios` producer was the previous shape and is exactly
# what this split retired.
PACKAGES="mos-bluetooth"

# `all` and not `amd64 arm64`. The payload is a POSIX shell script, a systemd
# unit and symlinks, with no ELF anywhere, so one archive is correct for every
# image this repository builds.
ARCHES="all"

# `family` is os/rootfs/packages-src itself, and it is here for one file: the
# shared copyright. The primary build context is this producer's OWN
# directory, so anything held in common with the sibling producers sits one
# level up and has to be named to be reachable.
#
# The unit body and the HCI-attach program are copied BYTE-IDENTICAL out of
# the tree that ships them, so that packaging them cannot become a second,
# drifting rendering of the same files. They live under os/boards/cx3576
# because that is where they were first written; their content is a
# radio-application fact, not a board fact -- the board facts they are paired
# with (/etc/mos/bt.conf, the radio kernel modules, the firmware) stay in
# mos-board-cx3576.
BUILD_CONTEXTS="family=os/rootfs/packages-src radio-units=os/boards/cx3576/overlay/etc/systemd/system radio-hwinit=os/boards/cx3576/hwinit"

# mos-bluetooth enables one unit at multi-user.target: mos-bt.service. The
# local-fs.target.wants link for var-lib-bluetooth.mount is not counted by
# this field.
ENABLEMENT="mos-bluetooth=1"
