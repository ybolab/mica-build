# The `ca-trust` producer: the TLS trust bundle and its individual anchors.
#
# Plain `KEY=value` lines only: no logic, no command substitution, no
# expansion. Safe to source from bash and to parse with grep/sed from anything
# else, and checked for that shape by os/rootfs/packages-src/build-deb.sh
# before it is sourced. os/rootfs/packages-src/README.md documents every field.

PACKAGES="mos-ca-trust"

# `all`, and generated ONCE. The bundle is data: the same 150 anchors, the same
# hash farm and the same bytes for arm64 and for amd64. That is already why
# os/rootfs/stages/10-base.Dockerfile runs its `certs` stage at $BUILDPLATFORM
# rather than at $TARGETPLATFORM -- generating it twice would spend minutes of
# qemu to produce identical files.
ARCHES="all"

# The pinned Debian trixie base the `certs` stage builds from, resolved by the
# driver through os/build-env/from.sh so that this producer stands on the same
# digest the rest of the tree does. A floating `debian:trixie-slim` here would
# be a trust store whose contents changed with the registry.
FROM_IMAGES="MOS_IMAGE_DEBIAN_TRIXIE"

# os/rootfs/scripts, so the generation stage can RUN the repository's own
# os/rootfs/scripts/ca-certificates-generate.sh rather than a restatement of
# it. A copy would be a second definition of what "generated today" means, and
# the two would drift on the first edit to either.
BUILD_CONTEXTS="scripts=os/rootfs/scripts"
