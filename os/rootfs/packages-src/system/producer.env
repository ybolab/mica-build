# The `system` producer: the `mos-system` package -- the common system policy,
# state mounts, seed and reconcile tools, units and operator account that every
# mos image carries whatever board it is for.
#
# Plain `KEY=value` lines only: no logic, no command substitution, no
# expansion. Safe to source from bash and to parse with grep/sed from anything
# else, and checked for that shape by os/rootfs/packages-src/build-deb.sh
# before it is sourced. os/rootfs/packages-src/README.md documents every field.

PACKAGES="mos-system"

# `all`. The payload is shell scripts, unit files and configuration -- there is
# no ELF anywhere in it -- so one archive is correct for every image this
# repository builds, and the board-dependent files (fstab, fw_env.config, the
# uenv repart definitions, boot.mount) are deliberately NOT here: they are
# rendered from board.env and belong to the board packages.
ARCHES="all"

# The payload's source tree, handed over as a named context rather than copied
# into this directory. os/rootfs/overlay-v2 is what stages/20-install installs
# today and stays the single source of those bytes; a copy beside this producer
# would be a second one that drifts.
BUILD_CONTEXTS="overlay=os/rootfs/overlay-v2"
