# MOS early-boot BusyBox configuration fragment. build-busybox.sh overlays it
# on allnoconfig and verifies the resolved config, so omitted applets stay off.
CONFIG_STATIC=y
CONFIG_STATIC_LIBGCC=y
CONFIG_LFS=y
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_BUSYBOX=y
# CONFIG_FEATURE_VERBOSE_USAGE is not set
# CONFIG_FEATURE_COMPRESS_USAGE is not set
# CONFIG_FEATURE_INSTALLER is not set
# CONFIG_INSTALL_NO_USR is not set
# CONFIG_FEATURE_SUID is not set
# CONFIG_PIE is not set

CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
# CONFIG_ASH_BASH_COMPAT is not set
# CONFIG_ASH_JOB_CONTROL is not set
# CONFIG_ASH_ALIAS is not set
# CONFIG_ASH_RANDOM_SUPPORT is not set
# CONFIG_ASH_EXPAND_PRMT is not set
# CONFIG_ASH_IDLE_TIMEOUT is not set
# CONFIG_ASH_MAIL is not set
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_SLEEP=y
# CONFIG_ASH_HELP is not set
# CONFIG_ASH_GETOPTS is not set
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
# CONFIG_FEATURE_SH_MATH_BASE is not set
CONFIG_FEATURE_SH_EXTRA_QUIET=y
# CONFIG_FEATURE_SH_STANDALONE is not set
# CONFIG_FEATURE_SH_NOFORK is not set
# CONFIG_FEATURE_SH_EMBEDDED_SCRIPTS is not set

CONFIG_CAT=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_KILL=y
CONFIG_LOSETUP=y
CONFIG_MKDIR=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
# CONFIG_FEATURE_MOUNT_FAKE is not set
# CONFIG_FEATURE_MOUNT_VERBOSE is not set
# CONFIG_FEATURE_MOUNT_HELPERS is not set
# CONFIG_FEATURE_MOUNT_LABEL is not set
# CONFIG_FEATURE_MOUNT_NFS is not set
# CONFIG_FEATURE_MOUNT_CIFS is not set
# CONFIG_FEATURE_MOUNT_FSTAB is not set
# CONFIG_FEATURE_MOUNT_LOOP is not set
CONFIG_PRINTF=y
CONFIG_READLINK=y
CONFIG_RMDIR=y
CONFIG_SLEEP=y
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_SWITCH_ROOT=y
CONFIG_SYNC=y
CONFIG_TEST=y
CONFIG_TEST1=y
# CONFIG_TEST2 is not set
CONFIG_UMOUNT=y
# CONFIG_FEATURE_UMOUNT_ALL is not set

# The early payload does not define PID 1, device management, networking, or
# login policy. Those remain mos-init, systemd/udev, and the selected main root.
# CONFIG_INIT is not set
# CONFIG_MDEV is not set
# CONFIG_IFCONFIG is not set
# CONFIG_IP is not set
# CONFIG_LOGIN is not set
# CONFIG_WATCHDOG is not set
