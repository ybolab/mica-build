# Debian 13 runtime snapshot. Advance explicitly when updating the base.
SUITE=trixie
SNAPSHOT=20260905T000000Z
# MIRROR IS NOT WHAT FETCHES, and assuming it is, is the easy mistake here.
# Nothing downloads through it: run.sh uses it twice, both after every archive
# is already local -- to spell debootstrap's apt_dest index filename, and as
# debootstrap's own mirror argument, on a run whose download phases are all
# disabled. Downloads use each record's absolute `url` in packages/*.json.
# To fetch those from somewhere else, set MOS_DEBIAN_MIRROR in the environment
# (rootfs/README.md, "Fetching through a mirror"); it is deliberately not set
# here, because a mirror is one host's configuration and not a property of the
# pins.
MIRROR=https://snapshot.debian.org/archive/debian/${SNAPSHOT}

# Exact runtime and helper pins are in packages/*.json and helpers/debootstrap.json.
