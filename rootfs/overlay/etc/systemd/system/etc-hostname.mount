[Unit]
Description=Hostname from DATA/state
# micad's hostname reconciler (pkgs/micad/micad/src/reconciler/hostname.rs) calls
# SetStaticHostname on org.freedesktop.hostname1, and systemd-hostnamed
# implements that by writing /etc/hostname. /etc is on the read-only squashfs,
# so without this bind the call fails EROFS and "set the hostname" in the web
# UI is a user-visible failure. Binding a file over a file is fine, and it does
# not write to the underlying read-only filesystem.
Requires=mica-seed-state.service
After=mica-seed-state.service
RequiresMountsFor=/mnt/data/state

[Mount]
What=/mnt/data/state/hostname
Where=/etc/hostname
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
