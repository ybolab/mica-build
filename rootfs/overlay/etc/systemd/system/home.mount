[Unit]
Description=Persistent home directory from the DATA partition
# The /mos/home source is seeded before binding this persistent user-data leaf.
# Identity and credentials live in separate protected DATA/state directories.
Requires=mica-seed-home.service
After=mica-seed-home.service
RequiresMountsFor=/mos

[Mount]
What=/mos/home
Where=/home
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
