[Unit]
Description=Prepare writable /mos and /srv DATA namespaces
Documentation=file:/usr/lib/mica/mica-data-layout
DefaultDependencies=no
RequiresMountsFor=/mnt/data
Requires=systemd-growfs@mnt-data.service
After=systemd-growfs@mnt-data.service
Before=mos.mount mos-containers.mount srv.mount mica-seed-home.service mica-seed-root.service local-fs.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/mica/mica-data-layout

[Install]
WantedBy=local-fs.target
