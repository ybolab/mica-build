[Unit]
Description=Prepare persistent DATA state and host identity
Documentation=file:/usr/lib/mos/mos-seed-state
DefaultDependencies=no
Requires=mos-data-layout.service
After=mos-data-layout.service
Before=local-fs.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/mos/mos-seed-state

[Install]
WantedBy=local-fs.target
