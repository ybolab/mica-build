[Unit]
Description=Persistent root home directory from the DATA partition
# The /mos/root source is seeded before binding this persistent user-data leaf.
# Identity and credentials live in separate protected DATA/state directories.
Requires=mica-seed-root.service
After=mica-seed-root.service
RequiresMountsFor=/mos

[Mount]
What=/mos/root
Where=/root
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
