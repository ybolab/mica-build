[Unit]
Description=mosd persistent state from DATA/state
# Keep management state outside the bounded general var project.
Requires=mos-seed-state.service
After=mos-seed-state.service
RequiresMountsFor=/mnt/data/state
Before=mosd.service apid.service

[Mount]
What=/mnt/data/state/mos
Where=/var/lib/mos
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
