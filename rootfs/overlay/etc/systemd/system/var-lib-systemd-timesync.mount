[Unit]
Description=timesyncd saved clock from DATA/state
# Seed the physical DATA leaf before binding it for timesyncd.
After=mos-seed-state.service
Before=systemd-timesyncd.service
RequiresMountsFor=/mnt/data

[Mount]
What=/mnt/data/state/timesync
Where=/var/lib/systemd/timesync
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
