#!/bin/sh
# Persist a machine id in the redundant U-Boot environment so every boot of
# this device gets the same /etc/machine-id from a read-only root.
#
# U-Boot passes the stored value as `systemd.machine_id=<32 hex>` on the kernel
# command line; systemd then seeds /etc/machine-id from it. This unit only
# GENERATES the value the first time and is gated off by
# ConditionKernelCommandLine once U-Boot is supplying one. The value takes
# effect from the NEXT boot, not this one.
#
# No-op (exit 0) when fw_setenv is missing or the environment is unreadable —
# which is the state on every build until the custom U-Boot lands. The unit is
# then INERT on hardware, which is expected, not a bug.
#
# Env ownership: this unit owns `machine_id` and nothing else. `BOOT_ORDER` and
# `BOOT_x_LEFT` belong to RAUC. The two writers are never concurrent: this unit
# runs once at boot, and mos-health.service (the only thing here that makes
# RAUC touch the env) is ordered After= it.
set -u

log() { echo "mos-machine-id: $*"; }
fail() { echo "mos-machine-id: FAIL $*" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

# 32 lowercase hex characters, no dashes — the form systemd.machine_id= wants.
is_machine_id() {
    [ "${#1}" -eq 32 ] || return 1
    case "$1" in *[!0-9a-f]*) return 1 ;; esac
    return 0
}

if ! have fw_setenv || ! have fw_printenv; then
    log "fw_setenv/fw_printenv not installed - U-Boot env not writable here; exiting 0"
    exit 0
fi

if ! fw_printenv >/dev/null 2>&1; then
    log "U-Boot environment unreadable (no /etc/fw_env.config or no env pair); exiting 0"
    exit 0
fi

existing=$(fw_printenv machine_id 2>/dev/null | sed -n 's/^machine_id=//p' | head -n1)
if is_machine_id "$existing"; then
    log "machine_id already set in the U-Boot environment; nothing to do"
    exit 0
fi

uuid=$(tr -d '-' </proc/sys/kernel/random/uuid 2>/dev/null | tr 'A-F' 'a-f')
is_machine_id "$uuid" || fail "could not generate a 32-hex machine id"

fw_setenv machine_id "$uuid" || fail "fw_setenv machine_id failed"
log "machine_id=$uuid stored in the U-Boot environment; takes effect from the NEXT boot"
exit 0
