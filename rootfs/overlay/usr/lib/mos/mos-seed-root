#!/bin/sh
# Seed the persistent root home directory on the DATA partition.
#
# root.mount binds /mos/root from the growing DATA filesystem.
# The physical source is created before its mount and retains existing files.
#
# ORDERING. This writes ONLY under /mos, never under /root, and it runs BEFORE
# root.mount. Both halves matter:
#   - Before, because mount(8) does not create the source of a bind. A seed
#     ordered after the bind could not have made the bind succeed in the first
#     place, so /root would never be mounted and the unit would never run.
#     tmpfiles.d cannot do this job either: systemd-tmpfiles-setup.service is
#     After=local-fs.target while root.mount is WantedBy=local-fs.target, so a
#     tmpfiles rule runs strictly AFTER the bind -- too late to create it.
#   - Only under /mos, because /root in the unbound view is a directory inside
#     the read-only verity squashfs. That is the hazard an "after the bind"
#     ordering is usually meant to avoid, and writing to the DATA path removes
#     it outright instead of ordering around it. /mos/root and /root are the
#     same inode once root.mount is up.
#
# NON-CLOBBERING. An existing /mos/root keeps every file it holds. The dotfiles
# below are seeded ONLY on the run that creates the directory: an operator who
# edits .bashrc must keep that edit across the next reboot, which is the entire
# point of this feature, so re-copying the factory copy on every boot would
# destroy exactly what the bind exists to preserve.
#
# The mode, in contrast, IS re-asserted every run. It is a property of the
# directory rather than a file an operator authored, /mos sits on DATA and is
# not verity-protected, and a root home gone group- or world-readable is a
# different defect from the one this feature fixes.
set -eu

# The factory dotfiles, read out of the image's own /root. Safe and correct to
# read here: this runs before root.mount, so /root is still the squashfs copy
# Debian shipped, and nothing is ever written back to it.
FACTORY_ROOT=/root

if [ -d /mos/root ]; then
    echo "root: /mos/root already present, contents left untouched"
else
    mkdir /mos/root
    for f in .bashrc .profile; do
        [ -f "${FACTORY_ROOT}/${f}" ] || continue
        cp -p "${FACTORY_ROOT}/${f}" "/mos/root/${f}"
    done
    echo "root: created /mos/root, seeded .bashrc/.profile from ${FACTORY_ROOT}"
fi

# 0700 root:root, the mode a root home must have. Numeric 0:0, not `root:root`:
# the directory outlives every rootfs that will ever be flashed onto the
# device, so its owner is part of the on-disk contract, not something to
# resolve out of whatever /etc/passwd the running image happens to carry.
chown 0:0 /mos/root
chmod 0700 /mos/root

sync
