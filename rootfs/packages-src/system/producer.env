# The `system` producer: the `mica-system` package -- the common system policy,
# state mounts, seed and reconcile tools, units and operator account that every
# mos image carries whatever board it is for.
#
# Plain `KEY=value` lines only: no logic, no command substitution, no
# expansion. Safe to source from bash and to parse with grep/sed from anything
# else, and checked for that shape by build-env/deb/build.sh before it is
# sourced. build-env/deb/README.md documents every field.

PACKAGES="mica-system"

# `all`. The payload is shell scripts, unit files and configuration -- there is
# no ELF anywhere in it -- so one archive is correct for every image this
# repository builds, and the board-dependent files (fstab, fw_env.config, the
# uenv repart definitions, boot.mount) are deliberately NOT here: they are
# rendered from board.env and belong to the board packages.
ARCHES="all"

# `family` is rootfs/packages-src itself, and it is here for one file: the
# shared copyright. The primary build context is this producer's OWN
# directory, so anything held in common with the sibling producers sits one
# level up and has to be named to be reachable.
#
# The payload's source tree, handed over as a named context rather than copied
# into this directory. rootfs/overlay is what stages/20-install installs
# today and stays the single source of those bytes; a copy beside this producer
# would be a second one that drifts.
BUILD_CONTEXTS="family=rootfs/packages-src overlay=rootfs/overlay"

# Six multi-user units: extensions, shadow reconciliation, provisioning import,
# health confirmation, networkd and resolved. Other enablement links belong to
# their respective boot targets and are checked as ordinary package payload.
ENABLEMENT="mica-system=6"
